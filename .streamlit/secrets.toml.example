# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your API keys
# DO NOT commit secrets.toml to Git!

CLAUDE_API_KEY = "your-claude-api-key-here"
CLAUDE_BASE_URL = "https://www.cun.ai"

GPT_API_KEY = "your-openai-api-key-here"
GPT_BASE_URL = "https://api.openai.com/v1"

MINIMAX_API_KEY = "your-minimax-api-key-here"
MINIMAX_BASE_URL = "https://api.minimaxi.com/v1"
